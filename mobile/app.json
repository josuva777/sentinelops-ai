{
  "expo": {
    "name": "SentinelOps AI",
    "slug": "sentinelops-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sentinelops",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#080b11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.sentinelops.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080b11"
      },
      "package": "io.sentinelops.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
