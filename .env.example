# =============================================================================
# SENTINELOPS ENTERPRISE CONFIGURATION & SECRETS TEMPLATE
# Copy to .env for local development. NEVER commit actual keys to git.
# =============================================================================

# --- 1. STRIPE SECURE BILLING ENGINE ---
# Real keys from your Stripe Dashboard (Developers -> API Keys)
# In development/sandbox mode, the system automatically activates a cryptographic
# fallback simulator with zero real charges and instant settlement.
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# --- 2. GATEWAY & APPLICATION URLS ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- 3. SMTP EMAIL OTP VERIFICATION DISPATCH ---
# Configure standard SMTP provider (SendGrid, AWS SES, Resend, or Google Workspace)
# If omitted, OTPs log to server stdout and return dev_otp for instant local testing.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_secret_...
SMTP_FROM="SentinelOps Security <security@sentinelops.ai>"

# --- 4. SUPREME MASTER ADMIN GOVERNANCE ---
MASTER_ADMIN_EMAIL=josuva732006@gmail.com
MASTER_ADMIN_PASS=josuva/12345
MASTER_ADMIN_STATIC_OTP=732006

# --- 5. PRODUCTION CLOUD DEPLOYMENT ---
# Vercel Frontend: Set NEXT_PUBLIC_API_URL to your Railway backend URL
# Railway Backend: Set PORT=8000 and mount persistent storage for sentinelops.db
RAILWAY_ENVIRONMENT=production
